# Copiá este archivo como .env.local y completá los valores.
# .env.local está en .gitignore (lo cubre la regla *.local): no se sube nunca.
#
# Los dos valores salen de Supabase → Settings → API.
# La anon key es segura de exponer en el navegador SIEMPRE Y CUANDO RLS esté
# activo en todas las tablas, que es lo que hace supabase/schema.sql.
#
# La contraseña de la base de datos NO va acá. No la necesita el frontend.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=
