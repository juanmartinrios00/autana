{
  // Configuración para desplegar en Cloudflare.
  //
  // Se despliega como un Worker que sirve los archivos de `dist`. El worker de
  // `worker/index.ts` se para adelante y reescribe las etiquetas del <head> en
  // las fichas de vehículo, para que compartir un link por WhatsApp muestre el
  // auto y no el preview genérico del sitio. Todo lo demás lo sirven los
  // assets directamente.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autana",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",

    // El binding es lo que le deja al worker pedir un archivo estático y
    // reescribirlo antes de devolverlo.
    "binding": "ASSETS",

    // Sin esto, entrar directo a /cars/renault-symbol-2010 devuelve 404: ese
    // archivo no existe, la ruta la resuelve el router en el navegador.
    // `single-page-application` hace que cualquier ruta desconocida sirva el
    // index.html manteniendo la URL.
    "not_found_handling": "single-page-application",

    // Por defecto, un pedido que coincide con un archivo de `dist` lo sirve
    // Cloudflare directo y el worker no llega a correr. Eso dejaba la portada
    // ---que es `index.html`, un archivo de verdad--- afuera de la redirección
    // al dominio propio: `/cars` redirigía y `/` no, así que el sitio seguía
    // existiendo dos veces justo en la página que más importa, y sin `canonical`
    // que desempatara. El síntoma es el peor: no falla, contesta 200.
    //
    // Con esto el worker corre primero en todo salvo `/assets/*`, que son los
    // bundles con el hash en el nombre. Por ahí no entra nadie: los pide el
    // navegador después de abrir una página que ya pasó por la redirección.
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
